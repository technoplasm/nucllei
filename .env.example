# Copy to `.env` (gitignored). The backend loads it at startup — `--reload` does
# NOT watch it, so restart the backend after changing it. Real environment
# variables win over values in this file.
#
# Full variable reference: README_API.md §3.

# --- Inference engine (OpenAI-compatible) ---
# Use the plural names: only these are honoured as env overrides on every boot
# (the singular OPENAI_API_BASE_URL / OPENAI_API_KEY are ignored once the
# connection has been saved from the admin UI). README_API.md §3.5.
OPENAI_API_BASE_URLS='http://prism-llens:13300/v1'
OPENAI_API_KEYS='EMPTY'
ENABLE_OLLAMA_API=false
# Dev fallback when the engine above is unreachable:
# ENABLE_OLLAMA_API=true
# OLLAMA_BASE_URL='http://localhost:11434'

# --- Code-execution sandbox (optional; see sandbox/README.md) ---
# The `builtin_sandbox` tool is registered when SANDBOX_URL is set. The token is
# opt-in and shared with the sandbox service: set the SAME value on both sides
# (generate with `openssl rand -hex 32`) and every sandbox endpoint then requires
# it. Leave it unset and the sandbox API stays unauthenticated — anyone who can
# reach it may claim any `user_id` and run code as, read/write, or destroy any
# user's workspace. Set it in real deployments. Env only: never a valve or a DB row.
# ASCII only: HTTP headers are decoded as latin-1, so a token with non-ASCII
# characters can never match and every request gets a 401 (the sandbox service
# names this in a startup warning).
# SANDBOX_URL is env-only too: there is no `sandbox_url` valve, so the destination
# cannot be changed from the admin UI or the DB.
# SANDBOX_URL='http://127.0.0.1:13302'
# SANDBOX_TOKEN='<same value as the sandbox container>'

# --- Reference data (/ext) and url= fetching ---
# /ext/** has no configuration (2026-10-03, ken): whatever is under
# $EXT_DIR (/ext in the image, ./ext on a host install) is
# served read-only to logged-in users at the same relative path —
# ext/cage/static/X <-> /ext/cage/static/X (files only). Docker: bind
# volumes at /ext/<path>. Host install / dev: put files or symlinks
# under ext/ (e.g. ext/cage/static -> <llens>/cage/data/static; a
# directory symlink placed there is served like a volume). The sandbox binds
# the same tree at its /ext, so a sandbox path and a /ext URL are the same
# string. nucllei never serves the host's /mnt (that was the morning's rule;
# wrong for host installs — NFS under /mnt would be exposed). There is no env
# override. The former EXT_UPSTREAMS / EXT_FILE_SCOPES / EXT_PUBLIC_BASES are
# gone. See README_API.md §3.8.
#
# The `url=` argument of fetch_url / feed_image / send_to_workspace fetches ANY
# scheme-qualified http(s) URL: the only destination refused is this server
# itself and its co-located services, computed at runtime (own addresses,
# default gateway, host.docker.internal) — there is no CIDR allowlist/denylist.
# A container cannot see the host's physical / VPN interfaces, so list the
# host's outward-facing IPs here (a co-located service published on the host
# would otherwise be reachable through them). Comma-separated IPs, default empty.
# (Was EXT_SELF_ADDRESSES until 2026-10-03.)
# SELF_ADDRESSES='10.105.2.1,10.105.2.3'
# Default size cap (bytes) when the resolver reads a URL or a sandbox path;
# tools pass their own per-call cap. Default 25 MB. (Was EXT_INLINE_MAX_BYTES.)
# FETCH_MAX_BYTES=26214400
# CORS: empty means same-origin only (no CORS at all, no warning). The UI is
# served from the same origin, so this is the production setting.
# CORS_ALLOW_ORIGIN=
# `builtin_fetch_url` and `builtin_feed_image` are always registered.

# --- Deployment-layer branding (shown in the UI next to the Nucllei version) ---
# WEBUI_NAME='llens'
# WEBUI_VERSION='v0.0.0-dev'
# WEBUI_COPYRIGHT='© Example Org'

# --- Shared-PC deployment (see _memos/auth-profile.md "共有 PC 配備") ---
# Suppresses autocomplete on the login form (form=off, password=new-password).
# This stops autofill of already-saved credentials; it CANNOT stop the browser's
# "save password?" prompt — that needs a browser policy on the terminal
# (Chrome/Edge `PasswordManagerEnabled=false`).
# ENABLE_LOGIN_AUTOCOMPLETE=false
# Idle timeout: how long a session survives *without user input*. It is NOT an
# absolute deadline — the clock restarts on every keypress/click, so a session
# never expires while someone is actually working. `1d` means "keep working all
# day, but log out a day after the person walks away". Units: s/m/h/d/w.
# Default `-1` = no idle timeout (also settable in Admin > Settings > General).
# JWT_EXPIRES_IN=4h
