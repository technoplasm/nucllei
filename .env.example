# Copy to `.env` (gitignored). The backend loads it at startup — `--reload` does
# NOT watch it, so restart the backend after changing it. Real environment
# variables win over values in this file.
#
# Full variable reference: README_API.md §3.

# --- Inference engine (OpenAI-compatible) ---
OPENAI_API_BASE_URL='http://prism-llens:13300/v1'
OPENAI_API_KEY='EMPTY'
ENABLE_OLLAMA_API=false
# Dev fallback when the engine above is unreachable:
# ENABLE_OLLAMA_API=true
# OLLAMA_BASE_URL='http://localhost:11434'

# --- Code-execution sandbox (optional; see sandbox/README.md) ---
# The `builtin_sandbox` tool is registered when SANDBOX_URL is set. The token is
# opt-in and shared with the sandbox service: set the SAME value on both sides
# (generate with `openssl rand -hex 32`) and every sandbox endpoint then requires
# it. Leave it unset and the sandbox API stays unauthenticated — anyone who can
# reach it may claim any `user_id` and run code as, read/write, or destroy any
# user's workspace. Set it in real deployments. Env only: never a valve or a DB row.
# ASCII only: HTTP headers are decoded as latin-1, so a token with non-ASCII
# characters can never match and every request gets a 401 (the sandbox service
# names this in a startup warning).
# SANDBOX_URL is env-only too: there is no `sandbox_url` valve, so the destination
# cannot be changed from the admin UI or the DB.
# SANDBOX_URL='http://127.0.0.1:13302'
# SANDBOX_TOKEN='<same value as the sandbox container>'

# --- Deployment-layer branding (shown in the UI next to the Nucllei version) ---
# WEBUI_NAME='llens'
# WEBUI_VERSION='v0.0.0-dev'
# WEBUI_COPYRIGHT='© Example Org'

# --- Shared-PC deployment (see _memos/auth-profile.md "共有 PC 配備") ---
# Suppresses autocomplete on the login form (form=off, password=new-password).
# This stops autofill of already-saved credentials; it CANNOT stop the browser's
# "save password?" prompt — that needs a browser policy on the terminal
# (Chrome/Edge `PasswordManagerEnabled=false`).
# ENABLE_LOGIN_AUTOCOMPLETE=false
# Also shorten the session on a shared terminal (default `-1` = never expires):
# JWT_EXPIRES_IN=4h
