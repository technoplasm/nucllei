{
	"name": "nucllei",
	"version": "0.6.5",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"dev": "vite dev --host",
		"dev:5050": "vite dev --port 5050",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_no_noninteractive_element_interactions:ignore,a11y_click_events_have_key_events:ignore\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_no_noninteractive_element_interactions:ignore,a11y_click_events_have_key_events:ignore\" --watch",
		"lint": "pnpm lint:frontend ; pnpm lint:types ; pnpm lint:backend",
		"lint:frontend": "eslint . --fix",
		"lint:types": "pnpm check",
		"lint:backend": "uv run ruff check nucllei",
		"format": "prettier --plugin-search-dir --write \"**/*.{js,ts,svelte,css,md,html,json}\"",
		"format:backend": "black . --exclude \".venv/|/venv/\"",
		"i18n:parse": "i18next --config i18next-parser.config.ts && prettier --write \"src/lib/i18n/**/*.{js,json}\"",
		"test:frontend": "vitest --passWithNoTests"
	},
	"devDependencies": {
		"@egoist/tailwindcss-icons": "^1.9.2",
		"@iconify-json/lucide": "^1.2.116",
		"@sveltejs/adapter-auto": "3.2.2",
		"@sveltejs/adapter-static": "^3.0.2",
		"@sveltejs/kit": "^2.5.20",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/postcss": "^4.0.0",
		"@tailwindcss/typography": "^0.5.13",
		"@types/markdown-it": "^14.1.2",
		"@types/sortablejs": "^1.15.9",
		"@typescript-eslint/eslint-plugin": "^6.17.0",
		"@typescript-eslint/parser": "^6.17.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.43.0",
		"i18next-parser": "^9.0.1",
		"postcss": "^8.4.31",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.6",
		"sass-embedded": "^1.81.0",
		"svelte": "^5.36.0",
		"svelte-check": "^4.2.0",
		"svelte-confetti": "^1.3.2",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^5.5.4",
		"vite": "^5.4.14",
		"vitest": "^1.6.1"
	},
	"type": "module",
	"dependencies": {
